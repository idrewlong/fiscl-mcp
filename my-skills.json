{
  "$comment": "my-skills project config. Generated by /my-skills:init — edit freely. Ownership globs are enforced by the guard-writes hook for my-skills subagents; omit an agent to leave it unrestricted.",
  "stack": ["Python 3.12+", "MCP Python SDK 2.x (MCPServer + MCP Apps)", "SQLite (stdlib)", "uv", "ruff", "pytest"],
  "commands": {
    "dev": "uv run fiscl serve",
    "lint": "uv run ruff check . && uv run ruff format --check .",
    "test": "uv run pytest -q",
    "build": "uv build"
  },
  "verify": ["lint", "test"],
  "ownership": {
    "backend": ["src/**", "tests/**", "scripts/**", "pyproject.toml", "uv.lock", "examples/**"],
    "qa": ["tests/**"],
    "devops": [".github/**"],
    "shared": ["docs/**", "specs/**", "README.md", "SECURITY.md", "CHANGELOG.md"]
  },
  "deploy": { "platform": "pypi", "productionBranch": "main" },
  "format": true,
  "allowEnvWrites": false
}
